# ---- ElevenLabs (required: speech-to-text AND text-to-speech) ----
# Free tier is enough for this project.
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice for the agent. This is Sarah, a premade voice.
# On the free plan the API rejects Voice Library voices with HTTP 402, so this
# must stay a premade voice unless you are on a paid plan.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ---- LLM ----
# Gemini has a free quota: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Pinned on purpose. Pipecat's default tracks the newest flash model, which
# returns 503 under load, and a 503 mid-call is silence.
GEMINI_MODEL=gemini-2.5-flash

# ---- Server ----
HOST=0.0.0.0
PORT=7860
